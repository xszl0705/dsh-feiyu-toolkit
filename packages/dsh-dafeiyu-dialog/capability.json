{
  "id": "dialog",
  "package": "dsh-dafeiyu-dialog",
  "version": "0.1.2",
  "intent": "跨渠道对话记录：追加消息、按会话读取最近若干条",
  "inputs": [
    "conversation",
    "role",
    "text"
  ],
  "outputs": [
    "recent-messages"
  ],
  "limits": [
    "只存对话文本与角色，不存推理过程",
    "按会话隔离，不跨会话泄漏"
  ],
  "failureModes": [
    {
      "code": "DIALOG_WRITE_FAILED",
      "meaning": "落盘失败，当前回复照常进行",
      "retry": "下次写入重试"
    },
    {
      "code": "READER_DIR_MISSING",
      "meaning": "读侧目录未配置（reader dir is required）",
      "retry": "返回空列表，不抛错"
    },
    {
      "code": "DIALOG_PARSE_SKIPPED",
      "meaning": "单行 JSON 解析失败（文件被外部改坏 / 半行）",
      "retry": "跳过该行继续读其余，不中断整次读取"
    }
  ],
  "scope": [
    "owner",
    "group",
    "private"
  ],
  "cost": {
    "cpu": "low",
    "network": "none"
  },
  "changedAt": "2026-11-14"
}
