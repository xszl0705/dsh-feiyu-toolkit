{
  "name": "dsh-draw",
  "version": "0.1.2",
  "description": "让大肥鱼会画图：matplotlib 数据图 + Pillow 排版卡片。只回路径不回 base64；需要准确数字/文字的图走这里。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "pylibs",
    "config.json",
    "capability.json",
    "cordis.patch.yml",
    "README.md",
    "config.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "draw",
    "chart",
    "matplotlib",
    "pillow",
    "image"
  ],
  "scripts": {
    "test": "node tests/run-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
