{
  "name": "dsh-gm-craft",
  "version": "0.1.3",
  "description": "GM 工坊：把「世界—故事—操作—反馈」四层能力固化成工具。建世界卡、出场景卡、生成群聊帖子、管镜头与选择回响。工具不做判断，只逼你填字段；能用代码校验的一律不用模型。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "templates",
    "cordis.patch.yml",
    "capability.json",
    "config.example.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "trpg",
    "gm",
    "worldbuilding",
    "story"
  ],
  "engines": {
    "node": ">=20"
  },
