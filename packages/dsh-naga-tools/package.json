{
  "name": "dsh-naga-tools",
  "version": "0.1.2",
  "description": "参照 NagaAgent 的 agent-manifest 契约，把 app_launcher / weather_time / system_control 三类能力做成 DSH 原生工具（纯 Node，无 Python、无 MCP 子进程）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "capability.json",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "nagaagent",
    "app-launcher",
    "weather",
    "system-control"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xszl0705/dsh-feiyu-toolkit.git",
    "directory": "packages/dsh-naga-tools"
  },
  "author": "xszl0705",
  "homepage": "https://github.com/xszl0705/dsh-feiyu-toolkit/tree/main/packages/dsh-naga-tools"
}
