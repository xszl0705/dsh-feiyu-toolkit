{
  "name": "dsh-rp-kit",
  "version": "0.1.2",
  "description": "跑团工坊：把规则书 / 设定 / 副本大纲 / 数值表收进项目库，按固定检查清单出评审工作包、记问题台账、跑数值模拟、出体检报告。评审判断由模型做，插件只提供清单、状态与计算。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "checklists",
    "cordis.patch.yml",
    "capability.json",
    "config.example.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "trpg",
    "roleplay",
    "rulebook-review",
    "infinite-flow"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xszl0705/dsh-feiyu-toolkit.git"
  },
  "author": "xszl0705"
}
