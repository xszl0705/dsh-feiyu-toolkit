{
  "name": "dsh-dafeiyu-core",
  "version": "0.2.0",
  "description": "大肥鱼的主体内核：单一 persona + 渠道表达约束 + 关系与形象公开档，所有渠道（客户端/桌宠/QQ/B站）从这里取身份，不各写一份。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./lib/compose.js": "./lib/compose.js",
    "./lib/persona.js": "./lib/persona.js"
  },
  "files": [
    "index.js",
    "lib",
    "assets",
    "config.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "persona",
    "pet"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
