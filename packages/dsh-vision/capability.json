{
  "id": "vision",
  "package": "dsh-vision",
  "version": "0.1.0",
  "intent": "看图：把图片转成文字描述，供模型在拿不到原生视觉时使用",
  "inputs": ["image-url", "image-bytes", "question"],
  "outputs": ["description", "usage"],
  "limits": [
    "只描述看到的，不推测图片外的事",
    "远程图只取公网地址，内网/回环拒绝",
    "图片大小有上限，超了拒绝而不是截断",
    "视觉模型不可用时如实报错，不编描述"
  ],
  "failureModes": [
    { "code": "VISION_UNAVAILABLE", "meaning": "视觉模型服务不可用", "retry": "如实返回错误" },
    { "code": "NON_PUBLIC_ADDRESS", "meaning": "图片地址指向内网/回环", "retry": "拒绝下载" },
    { "code": "IMAGE_TOO_LARGE", "meaning": "图片超过大小上限", "retry": "拒绝，不截断" }
  ],
  "scope": ["owner", "group", "private"],
  "cost": { "cpu": "low", "network": "outbound", "tokens": "variable" },
