{
  "name": "dsh-feiyu-look",
  "version": "0.1.2",
  "description": "大肥鱼的外观层：输入框上方一条只读状态条（心情 / 记忆 / 知识 / 技能 / 桌宠），数据走自己的聚合端点，不改宿主界面结构",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "capability.json",
    "install.ps1",
    "test"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ],
      "external": [
        "react"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xszl0705/dsh-feiyu-toolkit.git",
    "directory": "packages/dsh-feiyu-look"
  },
  "author": "xszl0705",
  "homepage": "https://github.com/xszl0705/dsh-feiyu-toolkit/tree/main/packages/dsh-feiyu-look"
}
