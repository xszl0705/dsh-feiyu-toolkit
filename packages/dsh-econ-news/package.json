    "index.js",
    "lib",
    "config.example.json",
    "capability.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "economics",
    "news",
    "imf",
    "briefing",
    "research"
  ],
  "scripts": {
    "test": "node tests/run-all.mjs"
  },
  "engines": {
    "node": ">=20"
  },
