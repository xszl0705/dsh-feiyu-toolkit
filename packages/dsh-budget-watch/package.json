{
  "name": "dsh-budget-watch",
  "version": "0.3.2",
  "description": "看会话 token 预算：步数、累计消耗、最近上下文规模、缓存命中率，按步数+上下文双条件给交接建议；shape 动作可定位缓存前缀断点。纯只读。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "config.json",
    "cordis.patch.yml",
    "README.md",
    "capability.json",
    "config.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "budget",
    "token",
    "cost",
    "usage"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "scripts": {
    "test": "node tests/budget.test.mjs && node tests/threshold-parity.test.mjs"
  },
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xszl0705/dsh-feiyu-toolkit.git",
    "directory": "packages/dsh-budget-watch"
  },
  "author": "xszl0705",
  "homepage": "https://github.com/xszl0705/dsh-feiyu-toolkit/tree/main/packages/dsh-budget-watch"
}
