{
  "name": "dsh-group-knowledge",
  "version": "0.1.1",
  "description": "群知识库：SQLite + FTS5，按群作用域存储与检索群聊公开内容；与私有记忆库分开。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.json",
    "capability.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "knowledge",
    "group",
    "sqlite"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
