{
  "name": "dsh-feiyu-mood-lite",
  "version": "0.4.1",
  "description": "轻量心情引擎：OCC 评价 + 差异化衰减 + 人格参数，写 ~/.dsh/feiyu-mood/state.json（与桌宠状态卡兼容）；只对外供数（桌宠 / QQ），不注入客户端对话",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mood",
    "emotion",
    "companion"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
