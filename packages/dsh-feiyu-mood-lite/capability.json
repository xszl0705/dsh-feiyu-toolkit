{
  "id": "mood",
  "package": "dsh-feiyu-mood-lite",
  "version": "0.4.1",
  "intent": "评估心情值并对外供数（桌宠 / QQ 读取），不注入客户端对话",
  "inputs": [
    "conversation-summary",
    "events"
  ],
  "outputs": [
    "mood-value",
    "expression-strength"
  ],
  "limits": [
    "只影响语气强弱，不改立场和原则",
    "不编造心情变化原因",
    "不向 DSH 客户端对话注入任何心情文本（仅 state.json / 端点 / 工具按需查询）"
  ],
  "failureModes": [
    {
      "code": "MOOD_SCAN_FAILED",
      "meaning": "扫描对话失败",
      "retry": "下一轮再试，保留上次心情"
    }
  ],
  "scope": [
    "owner",
    "group",
    "private"
  ],
  "cost": {
    "cpu": "low",
    "tokens": "small"
  },
  "changedAt": "2026-10-31T13:45:00+08:00"
}
