{
    "name":  "dsh-memory-unified",
    "version":  "0.7.0",
    "description":  "跨会话长期记忆（工具优先版）：SQLite + FTS5 存储，写入去重、失效语义、拒答检索、软删除、体检与导入导出，不接管上下文；Node 无 node:sqlite 时自动回退 JSON。",
    "type":  "module",
    "main":  "index.js",
    "files":  [
                  "index.js",
                  "lib",
                  "scripts",
                  "config.json",
                  "cordis.patch.yml",
                  "README.md",
                  "capability.json"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            },
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "memory",
                     "long-term-memory"
                 ],
    "engines":  {
                    "node":  "\u003e=20"
                },
    "license":  "MIT"
}