{
  "name": "dsh-qq-adapter",
  "version": "0.3.8",
  "description": "QQ 渠道适配器（OneBot 11 桥：SnowLuma / NapCat）：收消息 → 主体内核 compose → 回复 → 写 chatlog。同一套人格与记忆，只换渠道。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.example.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "qq",
    "onebot",
    "napcat"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
