{
  "name": "dsh-pet-sync",
  "version": "0.2.1",
  "description": "桌宠/悬浮窗统一编排：一个 form 切换「大肥鱼桌宠」与「小鲸鱼挂件」，并由插件生命周期负责开停（DSH 退出/禁用时一起停）。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "desktop-pet",
    "widget",
    "lifecycle"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
