{
  "id": "pet-diary",
  "package": "dsh-pet-diary",
  "version": "0.3.0",
  "intent": "日常日记、隐私日记、工作日志与例行任务",
  "inputs": [
    "text",
    "date",
    "tags"
  ],
  "outputs": [
    "diary-entry",
    "work-log",
    "routine-status"
  ],
  "limits": [
    "隐私日记不主动展示",
    "例行任务失败要可观察，不静默吞掉",
    "工具已合并为单入口 diary(action)/chatlog(action)，旧名不再注册",
    "例行日记会读本体每日日志（工作区选择与 mind-loop 同规则、只读一个、截尾 1800 字）作背景；读不到静默降级为空，不影响写日记"
  ],
  "failureModes": [
    {
      "code": "DIARY_WRITE_FAILED",
      "meaning": "磁盘写失败",
      "retry": "下次追加时重试"
    },
    {
      "code": "ROUTINE_MISSED",
      "meaning": "定时点错过后不补跑",
      "retry": "等下一个触发点"
    }
  ],
  "scope": [
    "owner"
  ],
  "cost": {
    "cpu": "low",
    "network": "none"
  },
  "changedAt": "2026-11-01T23:55:00+08:00"
}
