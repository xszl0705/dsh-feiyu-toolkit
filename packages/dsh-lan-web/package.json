{
  "name": "dsh-lan-web",
  "version": "0.1.1",
  "description": "把桌面客户端的 DSH web 界面开放到局域网：手机连同一个 WiFi 就能用浏览器跟进同一个会话。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "tests",
    "config.example.json",
    "capability.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "lan",
    "mobile",
    "gateway"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xszl0705/dsh-feiyu-toolkit.git"
  },
  "author": "xszl0705"
}
