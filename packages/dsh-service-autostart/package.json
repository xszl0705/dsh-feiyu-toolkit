{
  "name": "dsh-service-autostart",
  "version": "0.2.0",
  "description": "服务自愈：微心跳没在跑就静默拉起；探测 QQ 桥（SnowLuma，3001）端口状态，不拉起桥。",
  "type": "module",
  "main": "index.js",
  "files": [
    "index.js",
    "lib",
    "config.json",
    "capability.json",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "autostart",
    "snowluma",
    "mind-loop"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "peerDependencies": {
    "dsh-plugin-kit": ">=0.1.0"
  },
  "peerDependenciesMeta": {
    "dsh-plugin-kit": {
      "optional": true
    }
  }
}
